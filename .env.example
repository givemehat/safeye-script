# --- SMTP (required for email alerts) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=safeye@example.com
SMTP_STARTTLS=true

# --- Checks ---
# Seconds between cycles.
SAFEYE_INTERVAL=300
# Per-request timeout in seconds.
SAFEYE_TIMEOUT=10
# Total attempts before an endpoint is declared down (1 = no retries).
SAFEYE_RETRY_ATTEMPTS=3
# Base seconds between retries; doubles after each attempt.
SAFEYE_RETRY_BACKOFF=2
# Endpoints checked concurrently.
SAFEYE_MAX_WORKERS=10
# Set to false only for self-signed certificates in test environments.
SAFEYE_VERIFY_TLS=true

# --- Alerting ---
# Warn when an HTTPS certificate expires within this many days (0 disables).
SAFEYE_TLS_WARN_DAYS=14
# Remind every N hours while an endpoint stays down (0 = alert once, then quiet).
SAFEYE_REALERT_HOURS=0
# Dead man's switch pinged after every cycle, e.g. a healthchecks.io URL.
# Without it, a Safeye that has crashed looks exactly like healthy endpoints.
SAFEYE_HEARTBEAT_URL=

# --- Files ---
SAFEYE_CONFIG=requests.csv
SAFEYE_LOGS_DIR=logs
SAFEYE_RESUME_LOG=resume.log
SAFEYE_STATE_FILE=state.json
# Per-project log rotation.
SAFEYE_LOG_MAX_BYTES=1000000
SAFEYE_LOG_BACKUP_COUNT=5
